[Unit]
Description={{ sb_app_name | upper }}
After=syslog.target

[Service]
User={{ sb_app_user }}
Group={{ sb_app_user_group }}

Type=exec
EnvironmentFile={{ sb_applications_root_folder }}/{{ sb_app_name | upper }}/{{ sb_app_name }}.conf
ExecStart=java -jar {{ sb_applications_root_folder }}/{{ sb_app_name | upper }}/{{ sb_app_name | upper }}
WorkingDirectory={{ sb_applications_root_folder }}
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
